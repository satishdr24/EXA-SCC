managed with additional save implementation in class /ESRCC/BP_I_ALLOCATIONKEY_S unique;
strict;
extensible;
with draft;

define behavior for /ESRCC/I_AllocationKey_S alias AllocationKeyAll
draft table /esrcc/d_alloc_s
with unmanaged save
lock master total etag LastChangedAtMax
authorization master ( global )
extensible
{
  field ( readonly )
  SingletonID;

  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;
  action ( features : instance ) SelectCustomizingTransptReq parameter D_SelectCustomizingTransptReqP result [1] $self;

  association _AllocationKey { create ( features : instance, precheck ); with draft; }
}

define behavior for /ESRCC/I_AllocationKey alias AllocationKey
persistent table /esrcc/allockeys
draft table /esrcc/d_allock
etag master LocalLastChangedAt
lock dependent by _AllocationKeyAll
authorization dependent by _AllocationKeyAll
extensible
{
  field ( mandatory : create )
  Allocationkey;

  field ( readonly )
  WorkflowId,
  WorkflowStatus,
  Comments,
  SingletonID, CreatedAt, CreatedBy, LastChangedAt, LastChangedBy;

  field ( readonly : update )
  Allocationkey;

  update ( features : instance );
  delete ( features : instance );

  factory action ( features : instance ) Copy parameter /ESRCC/D_CopyAllocationKeyP [1];

  mapping for /esrcc/allockeys corresponding extensible
    {
      Allocationkey      = ALLOCATIONKEY;
      WorkflowId         = WORKFLOW_ID;
      WorkflowStatus     = WORKFLOW_STATUS;
      CommentId          = COMMENT_ID;
      CreatedBy          = CREATED_BY;
      CreatedAt          = CREATED_AT;
      LastChangedBy      = LAST_CHANGED_BY;
      LastChangedAt      = LAST_CHANGED_AT;
      LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
    }

  association _AllocationKeyAll { with draft; }
  association _AllocationKeyText { create ( features : instance ); with draft; }

  action ( features : instance ) Submit parameter /ESRCC/C_COMMENT result [1] $self;
  action ( features : instance ) Finalize result [1] $self;
  action ( features : instance ) Reopen result [1] $self;

//  determination UpdateInternalWorkflowStatus on modify { field Allocationkey; }
  determination UpdateWorkflowStatus on save { field WorkflowInternalStatus; }
  determination UpdateComment on save { field Comments; }
  determination TriggerWorkflow on save { field WorkflowStatus; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; delete; }
}

define behavior for /ESRCC/I_AllocationKeyText alias AllocationKeyText
persistent table /esrcc/allockeyt
draft table /esrcc/d_allockt
etag master LocalLastChangedAt
lock dependent by _AllocationKeyAll
authorization dependent by _AllocationKeyAll
extensible
{
  field ( mandatory : create )
  Spras;

  field ( readonly )
  SingletonID,
  Allocationkey;

  field ( readonly : update )
  Spras;

  update ( features : instance );
  delete ( features : instance );

  mapping for /esrcc/allockeyt corresponding extensible
    {
      Spras              = SPRAS;
      Allocationkey      = ALLOCATIONKEY;
      Description        = DESCRIPTION;
      LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
    }

  association _AllocationKeyAll { with draft; }
  association _AllocationKey { with draft; }

  determination UpdateInternalWorkflowStatus on modify { create; update; delete; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; delete; }
}