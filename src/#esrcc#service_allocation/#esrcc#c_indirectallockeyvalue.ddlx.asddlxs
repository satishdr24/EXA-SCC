@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: 'Base Key Value',
    typeNamePlural: 'Base Key Values'
  },
  presentationVariant: [{
    sortOrder: [{ by: 'Sysid', direction: #ASC },
                { by: 'LegalEntity', direction: #ASC},
                { by: 'CompanyCode', direction: #ASC },
                { by: 'CostObject', direction: #ASC },
                { by: 'CostCenter', direction: #ASC },
                { by: 'AllocationKey', direction: #ASC },
                { by: 'Fplv', direction: #ASC },
                { by: 'Ryear', direction: #ASC },
                { by: 'Poper', direction: #ASC }]
  }]
}
annotate view /ESRCC/C_INDIRECTALLOCKEYVALUE with
{
  @UI.facet: [ {
    id: 'CE',
    purpose: #STANDARD,
    type: #COLLECTION,
    label: 'Base Key Value'
  },
  {
    id: 'idIdentification',
    type: #IDENTIFICATION_REFERENCE,
    label: 'General Information',
    parentId: 'CE',
    position: 10
  },
  {
    id: 'Allocation',
    purpose: #STANDARD,
    type: #FIELDGROUP_REFERENCE,
    parentId: 'CE',
    targetQualifier: 'AllocationGroup',
    label: 'Allocation Information',
    position: 20
  },
  {
    id: 'Admin',
    purpose: #STANDARD,
    type: #FIELDGROUP_REFERENCE,
    parentId: 'CE',
    targetQualifier: 'AdminGroup',
    label: 'Admin Information',
    position: 30
  } ]

  @UI.hidden: true
  @EndUserText.label: 'UUID'
  IndirectAllocationUUID;

  @UI.hidden: true
  @EndUserText.label: 'Cost Object UUID'
  CostObjectUuid;

  @UI.identification: [ { position: 10 } ]
