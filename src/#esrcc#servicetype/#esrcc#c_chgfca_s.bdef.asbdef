projection;
strict;
extensible;
use draft;

define behavior for /ESRCC/C_Chgfca_S alias RuleAll
extensible
{
  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
  use action SelectCustomizingTransptReq;

  use association _Rule { create; with draft; }
}

define behavior for /ESRCC/C_Chgfca alias Rule
extensible
{
  use update;
  use delete;

  use action Copy;

  use association _RuleAll { with draft; }
}