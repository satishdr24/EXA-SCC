projection;
strict;
extensible;
use draft;

define behavior for /ESRCC/C_SrvMkp_S alias ServiceMarkupAll
extensible
{
  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
  use action SelectCustomizingTransptReq;

  use association _ServiceMarkup { create; with draft; }
}

define behavior for /ESRCC/C_SrvMkp alias ServiceMarkup
extensible
{
  use update;
  use delete;

  use action Copy;
  use action Submit;
  use action Finalize;
  use action Reopen;

  use association _ServiceMarkupAll { with draft; }
}