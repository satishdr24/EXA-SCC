projection implementation in class /ESRCC/BP_C_ROYCOMP_S unique;
strict;
extensible;
use draft;

define behavior for /ESRCC/C_RoyComp_S alias RuleAll
extensible
{
  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
  use action SelectCustomizingTransptReq;

  use association _Rule { create ( augment ); with draft; }
}

define behavior for /ESRCC/C_RoyComp alias Rule
extensible
{
  field ( modify )
  Description;

  use update ( augment );
  use delete;

  use action Copy;

  use association _RuleAll { with draft; }
  use association _RuleText { create; with draft; }
}

define behavior for /ESRCC/C_RoyCompText alias RuleText
extensible
{
  use update;
  use delete;

  use association _RuleAll { with draft; }
  use association _Rule { with draft; }
}