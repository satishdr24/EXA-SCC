@EndUserText.label: '/ESRCC/I_STW_SERVICEPRODUCT_2'
@MappingRole: true
define role /ESRCC/I_STW_SERVICEPRODUCT_2 {
    grant
        select
            on
                /ESRCC/I_STW_SERVICEPRODUCT_2
      where (Legalentity) = aspect pfcg_auth('/ESRCC/LE', /ESRCC/LE, ACTVT = '03') AND
      (Costobject,Costcenter) = aspect pfcg_auth('/ESRCC/CO', /ESRCC/OBJ, /ESRCC/CN, ACTVT = '03');       
                        
}