projection;
strict;
extensible;
use draft;

define behavior for /ESRCC/C_HierDef_S alias HierDefAll
extensible
{
  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
  use action SelectCustomizingTransptReq;

  use association _HierDef { create; with draft; }
}

define behavior for /ESRCC/C_HierDef alias HierDef
extensible
{
  use update;
  use delete;

  use action Copy;
  use action Submit;
  use action Finalize;
  use action Reopen;
  use action Sync;
  use action AutoGenerate;

  use association _HierDefAll { with draft; }
}