managed with additional save implementation in class /ESRCC/BP_I_HIER1_S unique;
strict;
extensible;
with draft;

define behavior for /ESRCC/I_Hier1_S alias HierarchyAll
draft table /esrcc/d_hier1_s
with unmanaged save
lock master total etag LastChangedAtMax
authorization master ( global )
extensible
{
  field ( readonly )
  SingletonID;


  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;
  action ( features : instance ) SelectCustomizingTransptReq parameter D_SelectCustomizingTransptReqP result [1] $self;

  association _Hierarchy { create ( features : instance, precheck ); with draft; }
}

define behavior for /ESRCC/I_Hier1 alias Hierarchy
persistent table /esrcc/hier1
draft table /esrcc/d_hier1
etag master LocalLastChangedAt
lock dependent by _HierarchyAll
authorization dependent by _HierarchyAll
extensible
{
  field ( mandatory : create )
  Hierarchy;

  field ( readonly )
  WorkflowId,
  WorkflowStatus,
  Comments,
  SingletonID,
  CreatedBy,
  CreatedAt,
  LastChangedBy,
  LastChangedAt,
  LocalLastChangedAt;

  field ( readonly : update )
  Hierarchy;

  update ( features : instance );
  delete ( features : instance );

  factory action ( features : instance ) Copy parameter /ESRCC/D_CopyHier1P [1];

  mapping for /esrcc/hier1 corresponding extensible
    {
      Hierarchy          = HIERARCHY;
      WorkflowId         = WORKFLOW_ID;
      WorkflowStatus     = WORKFLOW_STATUS;
      CommentId          = COMMENT_ID;
      CreatedBy          = CREATED_BY;
      CreatedAt          = CREATED_AT;
      LastChangedBy      = LAST_CHANGED_BY;
      LastChangedAt      = LAST_CHANGED_AT;
      LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
    }

  association _HierarchyAll { with draft; }
  association _HierarchyText { create ( features : instance ); with draft; }

  action ( features : instance ) Submit parameter /ESRCC/C_COMMENT result [1] $self;
  action ( features : instance ) Finalize result [1] $self;
  action ( features : instance ) Reopen result [1] $self;

  //  determination UpdateInternalWorkflowStatus on modify { field Hierarchy; }
  determination UpdateWorkflowStatus on save { field WorkflowInternalStatus; }
  determination UpdateComment on save { field Comments; }
  determination TriggerWorkflow on save { field WorkflowStatus; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; delete; }
}

define behavior for /ESRCC/I_Hier1Text alias HierarchyText
persistent table /esrcc/hier1_t
draft table /esrcc/d_hier1_t
etag master LocalLastChangedAt
lock dependent by _HierarchyAll
authorization dependent by _HierarchyAll
extensible
{
  field ( mandatory : create )
  Spras;

  field ( readonly )
  SingletonID,
  Hierarchy,
  LocalLastChangedAt;

  field ( readonly : update )
  Spras;

  update ( features : instance );
  delete ( features : instance );

  mapping for /esrcc/hier1_t corresponding extensible
    {
      Spras              = SPRAS;
      Hierarchy          = HIERARCHY;
      Description        = DESCRIPTION;
      LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
    }

  association _HierarchyAll { with draft; }
  association _Hierarchy { with draft; }

  determination UpdateInternalWorkflowStatus on modify { create; update; delete; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; delete; }
}