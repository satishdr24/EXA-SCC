@EndUserText.label: 'Acces Control for Forecast Line Items'
@MappingRole: true
define role /ESRCC/I_FORECAST_LINEITEMS {
    grant select on /ESRCC/I_FORECAST_LINEITEMS
      where (Legalentity) = aspect pfcg_auth('/ESRCC/LE', /ESRCC/LE, ACTVT = '03') AND
      (Costobject,Costcenter) = aspect pfcg_auth('/ESRCC/CO', /ESRCC/OBJ, /ESRCC/CN, ACTVT = '03');                      
}