@Metadata.layer: #CORE

@UI.headerInfo: { typeName: 'Description',
                  typeNamePlural: 'Descriptions',
                  title: { type: #STANDARD, label: 'Recharge/Reimbursement Rules Text', value: 'Spras' } }

annotate view /ESRCC/C_RR_RuleText with

{
  @UI.facet: [ { id: '/ESRCC/I_RR_RuleText',
                 purpose: #STANDARD,
                 type: #IDENTIFICATION_REFERENCE,
                 label: 'General Information',
                 position: 1 } ]
  @UI.lineItem: [ { position: 1 } ]
  @UI.textArrangement: #TEXT_LAST
  Spras;

  @UI.identification: [ { position: 2 } ]
  @UI.lineItem: [ { position: 2 } ]
  Description;

  @UI.hidden: true
  RuleId;

  @UI.hidden: true
  LanguageName;
}