@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: 'RR Object'
  }
}
annotate view /ESRCC/C_RR_Objct_S with
{
  @UI.facet: [ {
    id: 'Transport', 
    purpose: #STANDARD, 
    type: #IDENTIFICATION_REFERENCE, 
    label: 'Transport', 
    position: 1 , 
    hidden: #(HideTransport)
  }, 
  {
    id: '/ESRCC/I_RR_Objct', 
    purpose: #STANDARD, 
    type: #LINEITEM_REFERENCE, 
    label: 'Maintain Recharge/Reimbursement Objects', 
    position: 2 , 
    targetElement: '_Objct'
  } ]
  @UI.lineItem: [ {
    position: 1 
  } ]
  SingletonID;
  
  @UI.hidden: true
  HideTransport;
  
  @UI.identification: [ {
    position: 2 , 
    importance: #HIGH
  }, 
  {
    type: #FOR_ACTION, 
    dataAction: 'SelectCustomizingTransptReq', 
    label: 'Select Transport'
  } ]
  TransportRequestID;
}