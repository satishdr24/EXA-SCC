projection implementation in class /ESRCC/BP_C_RR_OBJCT_S unique;
strict;
extensible;
use draft;

define behavior for /ESRCC/C_RR_Objct_S alias ObjctAll
extensible
{
  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
  use action SelectCustomizingTransptReq;

  use association _Objct { create ( augment ); with draft; }
}

define behavior for /ESRCC/C_RR_Objct alias Objct
extensible
{
  field ( modify )
   Description;


  use update( augment );
  use delete;
  use action CopyObject;

  use association _ObjctAll { with draft; }
  use association _ObjctText { create; with draft; }
}

define behavior for /ESRCC/C_RR_ObjctText alias ObjctText
extensible
{
  use update;
  use delete;

  use association _ObjctAll { with draft; }
  use association _Objct { with draft; }
}