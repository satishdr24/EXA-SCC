@Metadata.layer: #CORE
@UI.headerInfo.typeName: 'RR Object Type'

annotate view /ESRCC/C_RR_ObjectType_S with

{
  @UI.facet: [ { id: 'Transport',
                 purpose: #STANDARD,
                 type: #IDENTIFICATION_REFERENCE,
                 label: 'Transport',
                 position: 1,
                 hidden: #(HideTransport) },
               { id: '/ESRCC/I_RR_ObjectType',
                 purpose: #STANDARD,
                 type: #LINEITEM_REFERENCE,
                 label: 'Maintain Recharge/Reimbursement Object Types',
                 position: 2,
                 targetElement: '_ObjectType' } ]
  @UI.lineItem: [ { position: 1 } ]
  SingletonID;

  @UI.hidden: true
  HideTransport;

  @UI.identification: [ { position: 2, importance: #HIGH },
                        { type: #FOR_ACTION, dataAction: 'SelectCustomizingTransptReq', label: 'Select Transport' } ]
  TransportRequestID;
}