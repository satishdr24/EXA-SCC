@Metadata.layer: #CORE

@UI.headerInfo: { typeName: 'RR Accounting Type',
                  typeNamePlural: 'RR Accounting Types',
                  title: { type: #STANDARD, label: 'Recharge/Reimbursement Accounting Types', value: 'AccountingType' },
                  description.value: 'Description' }

annotate view /ESRCC/C_RR_Accounting_Type with

{
  @UI.facet: [ { id: 'CE', type: #COLLECTION, position: 1 },
