@EndUserText.label: 'RR Lineitem Access Control'
@MappingRole: true
define role /ESRCC/I_RR_LI {
    grant 
        select
            on
                /ESRCC/I_RR_LI
          where 
      (LegalEntity) = aspect pfcg_auth('/ESRCC/LE', /ESRCC/LE, ACTVT = '03') AND
      (ObjectType,ObjectNumber) = aspect pfcg_auth('/ESRCC/CO', /ESRCC/OBJ, /ESRCC/CN, ACTVT = '03');                     
}