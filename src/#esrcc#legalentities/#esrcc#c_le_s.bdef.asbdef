extensible
{
  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
  use action SelectCustomizingTransptReq;

  use association _LegalEntity { create ( augment ); with draft; }
}

define behavior for /ESRCC/C_LE alias LegalEntity
extensible
